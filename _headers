/*
  # Security & CSP for map tiles + CDN
  Content-Security-Policy:
    default-src 'self';
    script-src 'self' https://cdn.jsdelivr.net;
    style-src  'self' 'unsafe-inline' https://cdn.jsdelivr.net;
    img-src    'self' data: blob: https://*.tile.openstreetmap.org https://*.tile.openrailwaymap.org;
    connect-src 'self' https://*.tile.openstreetmap.org https://*.tile.openrailwaymap.org;
    worker-src 'self' blob:;
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff