:root {
  --bg: #07121f;
  --glass: rgba(8, 18, 34, 0.68);
  --glass-2: rgba(12, 24, 44, 0.82);
  --border: rgba(255,255,255,0.14);
  --text: #ecf3ff;
  --muted: #b5c3d8;
  --accent: #58b8ff;
  --accent-2: #ffb24a;
  --success: #34d399;
  --error: #ff7d7d;
  --shadow: 0 20px 60px rgba(0,0,0,.42);
}

* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; font-family: Inter, Segoe UI, Arial, sans-serif; color: var(--text); background: var(--bg); }
a { color: inherit; text-decoration: none; }
code { background: rgba(255,255,255,0.08); padding: 0.15rem 0.35rem; border-radius: 6px; }

.bg-photo {
  position: fixed;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(4,9,18,.75), rgba(5,10,18,.4)),
    radial-gradient(circle at 20% 20%, rgba(88,184,255,.14), transparent 30%),
    radial-gradient(circle at 80% 30%, rgba(255,178,74,.12), transparent 24%),
    url("../img/train-bg.svg") center/cover no-repeat;
  transform: scale(1.03);
}
.bg-overlay {
  position: fixed;
  inset: 0;
  backdrop-filter: blur(5px);
  background: linear-gradient(180deg, rgba(3,8,14,.18), rgba(3,8,14,.48));
}

.auth-body, .panel-body { position: relative; }
.auth-shell, .panel-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 24px;
}
.auth-shell { display: grid; place-items: center; }
.panel-shell { max-width: 1400px; margin: 0 auto; }
.panel-shell.narrow { max-width: 820px; display: grid; place-items: center; }

.glass {
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: 24px;
  box-shadow: var(--shadow);
  backdrop-filter: blur(16px);
}

.auth-card {
  width: min(100%, 520px);
  padding: 30px;
}

.brand-pill {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .45rem .8rem;
  border-radius: 999px;
  background: rgba(88,184,255,0.16);
  border: 1px solid rgba(88,184,255,0.22);
  color: #d7eeff;
  font-size: .85rem;
  margin-bottom: 12px;
}

h1 { margin: 0 0 8px; font-size: clamp(2rem, 3.5vw, 3rem); }
h2 { margin: 0 0 12px; font-size: 1.15rem; }
.muted { color: var(--muted); }
.small { font-size: .9rem; }

.auth-form, .stack-form { display: grid; gap: 14px; margin-top: 20px; }
label span { display: block; margin-bottom: 8px; color: #dbe7f8; font-size: .92rem; }
input {
  width: 100%;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.08);
  color: var(--text);
  padding: 14px 16px;
  outline: none;
}
input:focus { border-color: rgba(88,184,255,.55); box-shadow: 0 0 0 4px rgba(88,184,255,.14); }
.checkbox-row { display: flex; align-items: center; gap: 10px; color: var(--muted); }
.checkbox-row input { width: auto; }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: 12px 18px;
  border-radius: 14px;
  border: 1px solid transparent;
  font-weight: 700;
  cursor: pointer;
}
.btn-primary { background: linear-gradient(135deg, var(--accent), #2e8dff); color: #07121f; }
.btn-secondary { background: linear-gradient(135deg, var(--accent-2), #ff8d37); color: #0a1321; }
.btn-ghost { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.12); color: var(--text); }

.flash-wrap { display: grid; gap: 10px; margin-top: 18px; }
.flash {
  padding: 12px 14px;
  border-radius: 14px;
  font-size: .95rem;
  border: 1px solid rgba(255,255,255,.12);
}
.flash.success { background: rgba(52,211,153,.15); color: #c9ffea; }
.flash.error { background: rgba(255,125,125,.14); color: #ffdada; }
.panel-flashes { margin: 18px 0; }

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 22px 24px;
  margin-bottom: 24px;
}
.topbar-actions, .center { display: flex; gap: 12px; flex-wrap: wrap; }
.center { justify-content: center; }

.grid { display: grid; gap: 20px; margin-bottom: 20px; }
.two-col { grid-template-columns: 1.2fr .8fr; }
.three-col { grid-template-columns: repeat(3, 1fr); }
.card { padding: 22px; }
.stack-gap > * + * { margin-top: 18px; }
.hero-card { min-height: 420px; }

.link-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
.link-grid.compact { grid-template-columns: 1fr; }
.quick-link {
  padding: 14px 16px;
  border-radius: 16px;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.12);
  transition: transform .15s ease, background .15s ease;
}
.quick-link:hover { transform: translateY(-2px); background: rgba(255,255,255,.11); }

.status-box, .placeholder-map, .row-card, .mini-item {
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.06);
}
.status-box { padding: 16px; display: grid; gap: 8px; }
.placeholder-map {
  min-height: 300px;
  display: grid;
  place-items: center;
  font-size: 1.1rem;
  color: #d9ebff;
  background:
    linear-gradient(135deg, rgba(88,184,255,.16), transparent),
    linear-gradient(45deg, rgba(255,178,74,.14), transparent),
    rgba(255,255,255,.03);
}

.table-like, .mini-list { display: grid; gap: 12px; }
.row-card { padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.row-card.column { align-items: flex-start; justify-content: flex-start; flex-direction: column; }
.mini-item { padding: 12px 14px; display: grid; gap: 4px; }
.token-text { word-break: break-all; color: #d8e8ff; font-size: .94rem; }
.centered-card { text-align: center; padding: 36px; }
.auth-footer { margin-top: 22px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.08); }

@media (max-width: 1050px) {
  .two-col, .three-col { grid-template-columns: 1fr; }
}

@media (max-width: 760px) {
  .auth-shell, .panel-shell { padding: 16px; }
  .topbar { padding: 18px; flex-direction: column; align-items: flex-start; }
  .auth-card, .card { padding: 18px; }
  .row-card { flex-direction: column; align-items: flex-start; }
}
